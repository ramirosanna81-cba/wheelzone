# Configuración de Conexión a Supabase (Wheels Zone)
# Obtené estas claves en tu panel de control de Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Número de WhatsApp oficial de Wheels Zone para recepción de compras y encargos
# Formato internacional sin símbolos (ej: 5491123456789)
NEXT_PUBLIC_WHATSAPP_PHONE=5491100000000

# Dirección física del Showroom / Punto de Retiro
NEXT_PUBLIC_STORE_ADDRESS="Rioja 281, B6022 Junín, Argentina"

